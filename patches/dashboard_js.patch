+// A server error can come back as text, as an object ({message, error, ...}) or not at all. Always return words,
+// never "[object Object]" (that hid the real reason a score file could not be read).
+export function errorText(err, fallback = 'Something went wrong.') {
+  const d = err?.response?.data?.detail ?? err?.response?.data?.message;
+  if (typeof d === 'string' && d.trim()) return d;
+  if (d && typeof d === 'object') {
+    if (typeof d.message === 'string' && d.message.trim()) return d.message;
+    if (typeof d.error === 'string' && d.error.trim()) return d.error;
+    if (Array.isArray(d) && d.length) return d.map((x) => (typeof x === 'string' ? x : x?.msg || '')).filter(Boolean).join('; ') || fallback;
+    try { return JSON.stringify(d).slice(0, 200); } catch (e) { return fallback; }
+  }
+  if (err?.code === 'ERR_NETWORK' || err?.message === 'Network Error') return 'The program could not be reached. Is it still running?';
+  return (typeof err?.message === 'string' && err.message) || fallback;
+}
